{
  "expo": {
    "name": "DAYCRAFT",
    "slug": "daycraft",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "daycraft",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daycraft.app"
    },
    "android": {
      "package": "com.daycraft.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E87935",
          "sounds": [
            "./assets/sounds/daycraft_chime.wav"
          ]
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "58a48a36-d468-425d-ac77-cddef772c9d5"
      }
    }
  }
}
